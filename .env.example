# PayShield Local Development Environment Template
# Copy to .env for local runs. Never commit .env or real secrets.

POSTGRES_DB=payshield
POSTGRES_USER=payshield
POSTGRES_PASSWORD=payshield_dev_pass
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/payshield

# Development-only JWT signing secret (at least 32 chars). Replace in any non-local deployment.
PAYSHIELD_JWT_SECRET=payshield-dev-only-jwt-secret-key-change-me-32chars
PAYSHIELD_JWT_ACCESS_TTL_SECONDS=900
PAYSHIELD_JWT_REFRESH_TTL_SECONDS=604800

# Development-only webhook HMAC secrets for simulated providers
PAYSHIELD_WEBHOOK_SECRET_ALPHA=dev-webhook-secret-alpha-change-me
PAYSHIELD_WEBHOOK_SECRET_BETA=dev-webhook-secret-beta-change-me
PAYSHIELD_WEBHOOK_SECRET_GAMMA=dev-webhook-secret-gamma-change-me

PAYSHIELD_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8080
